{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/food-subscription run build",
  "outputDirectory": "artifacts/food-subscription/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://satvikam.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
