# Local frontend dev env
PORT=4173
BASE_PATH=/

# Leave empty locally and on Vercel so /api stays same-origin.
# Local Vite proxies /api to http://localhost:3000.
# Vercel proxies /api to Render through vercel.json.
# Set this only if you intentionally want the browser to call another API origin directly.
VITE_API_BASE_URL=
